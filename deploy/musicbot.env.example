# Settings for one chriscord-musicbot (one per Chriscord server).
# install.sh copies this to /etc/chriscord/musicbot-<name>.env the first
# time. After editing:  sudo systemctl restart chriscord-musicbot@<name>

# Where the Chriscord server is. The bot runs next to it, so localhost.
# (For a server hosted from the admin panel, use its port.)
CHRISCORD_URL=http://127.0.0.1:7070

# The bot's token, from the app: Settings → Bots → New bot. It's the
# bot's whole identity, so keep this file private (install.sh makes it
# readable only by root and the bot). Someone with Manage Bots adds the bot
# to the server from its "Add to server" link; until then it can't join.
# Its name is the one it was made with (or what the server calls it).
CHRISCORD_BOT_TOKEN=

# What commands start with.
#BOT_PREFIX=!

# Leave the call after being alone in it this long.
#BOT_ALONE_TIMEOUT=5m

# How often to check GitHub for a new yt-dlp (it's swapped in by itself).
#BOT_YTDLP_CHECK=24h

# Use your own yt-dlp instead of the bot's managed copy (then it isn't
# updated automatically).
#BOT_YTDLP=/usr/local/bin/yt-dlp

# Extra yt-dlp arguments, e.g. cookies for sites that need a sign-in.
#BOT_YTDLP_ARGS=--cookies /var/lib/chriscord-musicbot/main/cookies.txt

# "best" keeps the site's own audio (usually Opus — no extra re-encode);
# "mp3" converts every download to MP3 first.
#BOT_AUDIO_FORMAT=best

# What's sent to the call: Opus bitrate, 1 (mono, like voices) or 2
# channels, and volume (music is loud next to voices; 1.0 = unchanged).
#BOT_BITRATE=96k
#BOT_CHANNELS=1
#BOT_VOLUME=0.5

# Limits.
#BOT_MAX_QUEUE=200
#BOT_MAX_PLAYLIST=50
#BOT_MAX_LENGTH=3h

#BOT_FFMPEG=ffmpeg
