# systemd unit for chriscord-musicbot — one instance per Chriscord server.
# Installed by deploy/install.sh to /etc/systemd/system/.
#
#   sudo systemctl status chriscord-musicbot@main
#   sudo systemctl restart chriscord-musicbot@main
#   sudo journalctl -u chriscord-musicbot@main -f
#
# Settings: /etc/chriscord/musicbot-<name>.env   Data: /var/lib/chriscord-musicbot/<name>

[Unit]
Description=chriscord music bot (%i)
Wants=network-online.target
After=network-online.target chriscord.service

[Service]
Type=simple
User=chriscord-musicbot
Group=chriscord-musicbot
Environment=BOT_DATA_DIR=/var/lib/chriscord-musicbot/%i
# yt-dlp keeps its cache under $HOME; Deno (for YouTube) is looked for on PATH.
Environment=HOME=/var/lib/chriscord-musicbot/%i
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/var/lib/chriscord-musicbot/%i
EnvironmentFile=/etc/chriscord/musicbot-%i.env
ExecStart=/usr/local/bin/chriscord-musicbot
Restart=always
RestartSec=5
TimeoutStopSec=10

# Hardening: it needs its data directory and the network. (No
# MemoryDenyWriteExecute: Deno's JavaScript engine needs to JIT.)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/chriscord-musicbot/%i
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
